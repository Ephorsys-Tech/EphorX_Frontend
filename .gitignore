gitignore
# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/
bower_components/

# Package manager files
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Build Output
# ==========================================
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.vercel/
.netlify/
coverage/

# ==========================================
# Environment Variables and Secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample
!.env.template

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log*
vite.log*

# ==========================================
# Cache and Temporary Files
# ==========================================
.cache/
.parcel-cache/
.turbo/
.temp/
.tmp/
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo
*.orig

# ==========================================
# React / Vite / Next.js
# ==========================================
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ==========================================
# Testing
# ==========================================
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ==========================================
# IDE and Editors
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ==========================================
# Local Configuration
# ==========================================
*.local
*.pid
*.seed
pids/

# ==========================================
# Database and Uploaded Files
# ==========================================
*.sqlite
*.sqlite3
*.db-journal

# Uncomment if these folders contain private
# user uploads or generated files:
# uploads/
# storage/
# private/

# ==========================================
# Deployment and Server Files
# ==========================================
.vercel
.netlify
.serverless/
.aws-sam/

# ==========================================
# Optional: Python
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ==========================================
# Optional: Mobile / React Native
# ==========================================
.expo/
.expo-shared/
android/.gradle/
android/app/build/
ios/Pods/

# ==========================================
# Optional: Local Certificates and Keys
# ==========================================
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ==========================================
# Optional: OS and Tool Files
# ==========================================
.fleet/
.history/
